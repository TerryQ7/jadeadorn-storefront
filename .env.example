# Everything here is optional. The app runs with no .env file at all.
# To change a setting, copy this file to .env.local and edit it.

# Where the SQLite database file lives. Created on first request.
# DATABASE_PATH=data/store.db

# Who takes payment. Unset or "mock" uses the built-in mock gateway. Any other
# value turns the mock gateway's page and endpoint off (they answer 404), so a
# deployment set up for a real provider cannot be paid with a test card.
# PAYMENT_PROVIDER=mock

# Secret used to verify payment webhooks. Leave unset while using the built-in
# mock gateway (a random secret is generated at startup). Set it to the value
# from your payment provider's dashboard when connecting a real provider.
# PAYMENT_WEBHOOK_SECRET=
